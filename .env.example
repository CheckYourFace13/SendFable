# ── Core ────────────────────────────────────────────────────────────────────
# Public URL of the app (no trailing slash). Used in emails, links, webhooks.
APP_URL="http://localhost:3000"

# Postgres connection string (docker compose provides one automatically)
DATABASE_URL="postgresql://sendfable:sendfable@localhost:5432/sendfable?schema=public"

# Redis connection string (BullMQ queue + rate limiting)
REDIS_URL="redis://localhost:6379"

# ── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5: trust APP_URL / proxy Host headers (safe behind your own Caddy/HTTPS).
AUTH_TRUST_HOST="true"

# ── Amazon SES ──────────────────────────────────────────────────────────────
# Leave AWS keys BLANK for local dev: emails are logged to the console and
# written as .eml files to /tmp/outbox instead of being sent.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# SES configuration set (must have an SNS event destination for
# Bounce/Complaint/Delivery events — see README).
SES_CONFIGURATION_SET="sendfable-events"

# SNS webhook signature verification. Default is strict (true).
# Set false only for local fixture tests without Amazon certs.
# SNS_VERIFY_STRICT="false"

# Early launch (production): close public signup, block real campaign sends without SES.
# EARLY_LAUNCH="true"
# ALLOW_PUBLIC_SIGNUP="false"
# Explicit campaign delivery gate (default false when unset). Independent of SES sandbox.
# CAMPAIGN_SEND_ENABLED="false"
# Admin-only SES infrastructure test script (scripts/ses-controlled-test.ts). Default false.
# SES_CONTROLLED_TEST_ENABLED="false"
# Global campaign send ceiling in messages/second (launch default 5; AWS account max is 14).
# PLATFORM_SEND_RATE_PER_SEC="5"
# Worker concurrency (BullMQ jobs in parallel). Still bounded by PLATFORM_SEND_RATE_PER_SEC.
# WORKER_CONCURRENCY="5"
# Platform admin UI (/admin) — defaults to first registered user if unset.
# PLATFORM_OWNER_EMAIL="chris@iscreamstudio.com"

# The platform's own verified sending domain. From-addresses on strict-DMARC
# providers (gmail.com etc.) are rewritten to localpart@this-domain.
PLATFORM_SEND_DOMAIN="send.sendfable.com"

# Ops alerting (scripts/ops-alert.js): owner email for monitor/backup alerts.
# Must be an SES-verified identity while the account is in sandbox.
OWNER_ALERT_EMAIL=""

# Contact form notification target (defaults to OWNER_ALERT_EMAIL).
# Topic mailboxes (support@/privacy@/…) are labeled in the subject while SES
# sandbox cannot deliver to unverified @sendfable.com addresses.
SUPPORT_NOTIFY_EMAIL=""

# Off-host encrypted backups (Option A). Prefer /root/sendfable-backups/backup-iam.env
# over putting secrets in this file. See docs/OFFHOST_BACKUP_SETUP.md.
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=postgres
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_AGE_RECIPIENT=
# BACKUP_AGE_KEY_FILE=/root/sendfable-backups/age-backup.key

# First-party analytics (src/lib/analytics.ts) — privacy-conscious events table.
# No third-party scripts. See docs/ANALYTICS_DECISION.md and docs/SF-007_SEARCH_BASELINE.md.
ANALYTICS_ENABLED="false"
# ANALYTICS_RETENTION_DAYS="90"

# Search engine ownership verification meta (public HTML only — not secrets).
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""

# IndexNow key for Bing/Yandex URL submission after publish. Key file at /indexnow/key.txt.
# INDEXNOW_KEY=""

# Referral account credits — keep false until economics + Stripe credit method approved.
# REFERRAL_CREDITS_ENABLED="false"
# REFERRAL_CREDIT_CENTS="1000"
# REFERRAL_QUALIFYING_PAID_DAYS="30"

# Nurture — general activation stays false until exact owner approval phrases.
# NURTURE_GENERAL_ENABLED="false"
# NURTURE_TEST_MODE="false"
# NURTURE_TEST_ALLOWLIST=""
# NURTURE_TEST_PHYSICAL_ADDRESS=""

# ── Stripe ──────────────────────────────────────────────────────────────────
# Leave blank in dev to disable billing (everything else still works).
# Production: use sk_live_ / pk_live_ only. Never mix test price IDs with live keys.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_EXPECTED_ACCOUNT_ID=""
# Public Checkout gate (default false when unset).
STRIPE_BILLING_ENABLED="false"
# Owner-only controlled Checkout while public billing is off.
STRIPE_OWNER_TEST_ENABLED="false"

# Price IDs — created for you by: npm run stripe:setup
# Prefer *_ANNUAL; *_YEARLY is an alias accepted by the app.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_GROWTH_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_PRO_PLUS_MONTHLY=""
STRIPE_PRICE_PRO_PLUS_ANNUAL=""
STRIPE_PRICE_PRO_PLUS_YEARLY=""

# ── Uploads (optional S3) ───────────────────────────────────────────────────
# If S3_BUCKET is blank, images are stored on the local /uploads volume.
S3_BUCKET=""
S3_REGION=""
S3_PUBLIC_URL=""

# ── Dev mail outbox ─────────────────────────────────────────────────────────
# Where .eml files are written when AWS credentials are absent.
# Defaults to /tmp/outbox (or %TEMP%\outbox on Windows).
# OUTBOX_DIR="/tmp/outbox"

# Worker concurrency (BullMQ)
# WORKER_CONCURRENCY="5"

# ── Text Messaging (SMS) ─────────────────────────────────────────────────────
# Backend code is prepared behind these server-side flags. Safe defaults keep
# every customer-facing SMS surface dark and every live provider/Stripe write
# impossible. Do NOT flip these in production until the SMS owner checklist
# in docs/SMS_OWNER_ACTIONS.md is complete.
#
# SENDFABLE_SMS_CODE_ENABLED="true"              # code paths available (default true)
# SENDFABLE_SMS_PUBLIC_ENABLED="false"           # hide public SMS pricing/marketing
# SENDFABLE_SMS_ACCOUNT_SIGNUP_ENABLED="false"   # customers cannot pick a text plan
# SENDFABLE_SMS_BILLING_ENABLED="false"          # no Stripe SMS subscription writes
# SENDFABLE_SMS_ACTIVATION_PURCHASE_ENABLED="false"  # no $99 activation charge
# SENDFABLE_SMS_REGISTRATION_ENABLED="false"     # no carrier registration submission
# SENDFABLE_SMS_NUMBER_PURCHASE_ENABLED="false"  # no phone-number purchase
# SENDFABLE_SMS_LIVE_SENDING_ENABLED="false"     # no live provider send calls
# SENDFABLE_SMS_INBOUND_ENABLED="false"          # real inbound webhooks ignored
# SENDFABLE_SMS_REPLY_ENABLED="false"            # inbox replies cannot send
# SENDFABLE_SMS_ADMIN_ENABLED="true"             # owner SMS admin area
# SENDFABLE_SMS_MOCK_PROVIDER_ENABLED="true"     # mock provider is the default

# Telnyx (dedicated SMS credentials — never reuse AWS SES keys; never store in DB)
# See docs/SF-017_TELNYX_OWNER_SETUP.md — do not buy numbers or submit registration yet.
# TELNYX_API_KEY=""
# TELNYX_PUBLIC_KEY=""          # Ed25519 webhook verification (Mission Control public key)
# TELNYX_WEBHOOK_SECRET=""      # optional HMAC fallback for controlled tests only
# TELNYX_MESSAGING_PROFILE_ID=""
# TELNYX_CONNECTION_ID=""
# SMS_SENSITIVE_DATA_KEY=""     # 32-byte key (base64) for EIN/BRN encryption at rest
# SMS_OUTBOX_DIR=""   # mock provider writes JSON outbox files here (defaults to OS temp)

# SMS Stripe catalog IDs — created by scripts/stripe-sms-setup.ts --confirm-live-sms-catalog
# (products active=false; all customer-facing SENDFABLE_SMS_* flags must stay false)
# confirmation: npx tsx scripts/stripe-sms-setup.ts --confirm-live-sms-catalog
# STRIPE_PRICE_SMS_TEXT_ENTRY_MONTHLY=""
# STRIPE_PRICE_SMS_TEXT_ESSENTIALS_MONTHLY=""
# STRIPE_PRICE_SMS_TEXT_ESSENTIALS_MONTHLY_BUNDLED=""
# STRIPE_PRICE_SMS_TEXT_ADVANTAGE_MONTHLY=""
# STRIPE_PRICE_SMS_TEXT_ADVANTAGE_MONTHLY_BUNDLED=""
# STRIPE_PRICE_SMS_OUTBOUND_TEXT_ENTRY=""
# STRIPE_PRICE_SMS_OUTBOUND_TEXT_ESSENTIALS=""
# STRIPE_PRICE_SMS_OUTBOUND_TEXT_ADVANTAGE=""
# STRIPE_PRICE_SMS_INBOUND_OVERAGE=""
# STRIPE_PRICE_SMS_ACTIVATION=""
# STRIPE_PRODUCT_SMS_TEXT_ENTRY=""
# STRIPE_PRODUCT_SMS_TEXT_ESSENTIALS=""
# STRIPE_PRODUCT_SMS_TEXT_ADVANTAGE=""
# STRIPE_PRODUCT_SMS_INBOUND_OVERAGE=""
# STRIPE_PRODUCT_SMS_ACTIVATION=""
# STRIPE_METER_SMS_TEXT_ENTRY_OUTBOUND=""
# STRIPE_METER_SMS_TEXT_ESSENTIALS_OUTBOUND=""
# STRIPE_METER_SMS_TEXT_ADVANTAGE_OUTBOUND=""
# STRIPE_METER_SMS_INBOUND_OVERAGE=""
